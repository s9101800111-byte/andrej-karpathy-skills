<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FormworkQTO</AssemblyName>
    <RootNamespace>FormworkQTO</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit 2026 API 參考組件（僅編譯用，不會複製到輸出） -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.*" />
  </ItemGroup>

  <!-- 在 Windows 上建置完成後，自動部署到 Revit 2026 的 Addins 資料夾 -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <AddinFiles Include="$(TargetDir)$(AssemblyName).dll;$(MSBuildProjectDirectory)\..\FormworkQTO.addin" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinFiles)" DestinationFolder="$(APPDATA)\Autodesk\Revit\Addins\2026" />
  </Target>

</Project>
