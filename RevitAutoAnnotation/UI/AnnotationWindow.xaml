<Window x:Class="RevitAutoAnnotation.UI.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自動標註"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <StackPanel Margin="14">

        <TextBlock Text="標註模式" FontWeight="Bold" Margin="0,0,0,6"/>
        <RadioButton x:Name="WallMode" Margin="0,2"
                     Content="牆體尺寸標註（牆長＋牆厚）" IsChecked="True"/>
        <RadioButton x:Name="OpeningMode" Margin="0,2"
                     Content="門窗標註（標籤＋開口寬度）"/>
        <RadioButton x:Name="ColumnMode" Margin="0,2"
                     Content="柱位放樣圖（柱標籤＋柱心至格線距離）"/>
        <RadioButton x:Name="BeamMode" Margin="0,2"
                     Content="梁定位圖（梁標籤＋梁心至格線距離）"/>

        <Separator Margin="0,10"/>

        <TextBlock Text="選項" FontWeight="Bold" Margin="0,0,0,6"/>
        <CheckBox x:Name="CreateDimsCheck" Content="建立尺寸標註" IsChecked="True" Margin="0,2"/>
        <CheckBox x:Name="CreateTagsCheck" Content="建立標籤" IsChecked="True" Margin="0,2"/>
        <CheckBox x:Name="WallThicknessCheck" Content="同時標註牆厚（僅牆體模式）" IsChecked="True" Margin="0,2"/>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="標註偏移距離 (mm)：" VerticalAlignment="Center"/>
            <TextBox x:Name="OffsetBox" Text="500" Width="70" VerticalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="RunButton" Content="執行標註" Height="34" Margin="0,14,0,0"
                FontWeight="Bold" Click="RunButton_Click"/>

        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="#444444"
                   Text="提示：請先切換到要出圖的平面視圖，再按「執行標註」。"/>
    </StackPanel>
</Window>
